NERV_ADDR=127.0.0.1:8080
NERV_AUTH_TOKEN=dev-token
DATABASE_URL=postgres://nerv:nerv@localhost:5432/nerv?sslmode=disable

# Use echo for local smoke tests without cluster AI services.
NERV_LLM_PROVIDER=echo
NERV_LLM_MODEL=echo-v0
# NERV_LLM_PROVIDER=agentgateway
# NERV_LLM_MODEL=openai/gpt-5-mini
# NERV_AGENTGATEWAY_URL=http://agentgateway-proxy.agentgateway.svc.cluster.local
# NERV_AGENTGATEWAY_TOKEN=

NERV_DECISION_GATEWAY_URL=
NERV_DECISION_GATEWAY_TOKEN=
NERV_DECISION_NAME=alert-disposition
NERV_DECISION_VERSION=v1

NERV_GOTIFY_URL=
NERV_GOTIFY_TOKEN=
NERV_HTTP_TIMEOUT=30s

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
