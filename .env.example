NERV_ADDR=127.0.0.1:8080
NERV_AUTH_TOKEN=dev-token
DATABASE_URL=postgres://nerv:nerv@localhost:5432/nerv?sslmode=disable

# Use echo for local smoke tests without cluster AI services.
NERV_LLM_PROVIDER=echo
NERV_LLM_MODEL=echo-v0
# NERV_LLM_PROVIDER=agentgateway
# NERV_LLM_MODEL=openai/gpt-5-mini
# NERV_AGENTGATEWAY_URL=http://agentgateway-proxy.agentgateway.svc.cluster.local
# NERV_AGENTGATEWAY_TOKEN=
# Optional; empty disables fallback. Never guess a fallback model.
NERV_LLM_FALLBACK_MODEL=

# Bounded durable agent loop.
NERV_AGENT_MAX_ROUNDS=4
NERV_AGENT_MAX_TOOL_CALLS=6
NERV_AGENT_TIMEOUT=75s
NERV_AGENT_MAX_TOKENS=12000
NERV_AGENT_TOOL_CONCURRENCY=2
NERV_AGENT_MODEL_TIMEOUT=30s
NERV_AGENT_TOOL_TIMEOUT=30s
NERV_AGENT_MAX_EVIDENCE_BYTES=32768
NERV_AGENT_MAX_TOOL_OUTPUT_BYTES=32768
# Cost accounting stays unknown/disabled unless both prices are configured.
NERV_AGENT_MAX_COST_USD=0
NERV_AGENT_INPUT_PRICE_PER_MILLION_TOKENS_USD=0
NERV_AGENT_OUTPUT_PRICE_PER_MILLION_TOKENS_USD=0

# Durable admission controls shared across replicas.
NERV_ADMISSION_MAX_CONCURRENT=2
NERV_ADMISSION_LEASE_TTL=10m
NERV_ADMISSION_ASK_PER_MINUTE=6
NERV_ADMISSION_ALERT_PER_MINUTE=30
NERV_ADMISSION_DETECTOR_PER_MINUTE=30
NERV_ADMISSION_DAILY_MAX_TOKENS=240000
# Requires both model prices above; zero disables daily cost enforcement.
NERV_ADMISSION_DAILY_MAX_COST_USD=0

NERV_DECISION_GATEWAY_URL=
NERV_DECISION_GATEWAY_TOKEN=
NERV_DECISION_NAME=alert-disposition
NERV_DECISION_VERSION=v1

NERV_GOTIFY_URL=
NERV_GOTIFY_TOKEN=
NERV_NOTIFICATION_DEBOUNCE=2m
NERV_HTTP_TIMEOUT=30s

# Human-approved GitOps proposal records. Approval does not write repository or cluster state.
NERV_GITOPS_REPOSITORY=mvaldes14/k8s-apps
NERV_GITOPS_TARGETS_JSON='[{"id":"nerv","path":"apps/nerv/deployment.yaml","resource":{"api_version":"apps/v1","kind":"Deployment","namespace":"nerv","name":"nerv"}}]'

NERV_DETECTION_ENABLED=false
NERV_DETECTION_PERSISTENCE=2m
NERV_DETECTION_COOLDOWN=30m
NERV_DETECTION_RESYNC=30s
NERV_DETECTION_WORKERS=2
NERV_DETECTION_QUEUE_CAPACITY=512
NERV_DETECTION_RESTART_THRESHOLD=3
NERV_DETECTION_RESTART_WINDOW=10m
NERV_DETECTION_NAMESPACES=nerv
NERV_DETECTION_MAINTENANCE_ANNOTATION=nerv.io/maintenance

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
